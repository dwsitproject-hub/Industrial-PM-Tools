# EngPro STAGING backend environment — copy to .env.staging and fill in.
# NEVER commit .env.staging; it lives only on the BE server.

# ApsaraDB RDS PostgreSQL (add &sslmode=require if SSL is enabled on the instance)
#
# IMPORTANT: the password must be PERCENT-ENCODED inside this URL. A raw '@' ends the
# credentials section and Prisma then fails with "P1013 ... invalid port number".
#   @ -> %40    # -> %23    / -> %2F    : -> %3A    ? -> %3F
#   & -> %26    % -> %25    + -> %2B    space -> %20
# Encode it without printing the password anywhere:
#   read -rs -p "RDS password: " PW; echo
#   docker run --rm -e PW="$PW" python:3-alpine #     python -c "import urllib.parse,os;print(urllib.parse.quote(os.environ['PW'],safe=''))"
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@pgm-d9jx9o06qae8gf3h.pgsql.ap-southeast-5.rds.aliyuncs.com:5432/industrial_pm?connection_limit=10

# Generate each with:  openssl rand -hex 64   (two DIFFERENT values)
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_OTHER_64_HEX_BYTES

ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# The origin users browse to (FE server)
CORS_ORIGIN=http://172.28.92.56:3060

# Staging is plain HTTP on the private network -> cookie must not be Secure
COOKIE_SECURE=false

WORKSPACE_TZ=Asia/Jakarta
THROTTLE_LIMIT=5
PORT=3000

# ── Email (activation + password reset) ───────────────────────────────
# Fill these in to send real email. Leave SMTP_HOST empty and the flows still work:
# the link is logged by the API and shown to the manager in Settings -> Users to share.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EngPro <no-reply@energi-up.com>
# MUST be the URL users reach the app on, or the emailed links point nowhere:
APP_BASE_URL=http://172.28.92.56:3060
ACTIVATION_TTL_HOURS=72
RESET_TTL_MINUTES=60
