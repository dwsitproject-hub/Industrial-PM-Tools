# EngPro PRODUCTION backend environment — copy to .env.production and fill in.
# NEVER commit this file. See SECURITY_HARDENING.md for the full go-live checklist.
#
# With DEPLOY_ENV=production the API validates this file at boot and REFUSES TO START
# if anything below would put credentials on the wire in cleartext.

# ── Security posture ──────────────────────────────────────────────────
DEPLOY_ENV=production
COOKIE_SECURE=true
# Proxies in front of the API that append to X-Forwarded-For (WAF/LB + edge nginx + app
# nginx). Count them exactly — see the note in .env.staging.example.
TRUST_PROXY=2
# Strict-Transport-Security max-age in seconds on API responses. Start at 300 while you
# confirm every path works over TLS, then raise to 31536000 (1 year). Browsers keep the
# longest value they have seen, so this cannot be shortened in practice.
HSTS_MAX_AGE=300

# ── Database ──────────────────────────────────────────────────────────
# Use the least-privilege application role, NOT the instance's privileged account.
# Create it with backend/prisma/sql/create-app-role.sql (AR-16).
# The password MUST be percent-encoded here: @ -> %40  # -> %23  / -> %2F  : -> %3A
DATABASE_URL=postgresql://industrial_pm_app:CHANGE_ME@db.internal:5432/industrial_pm?connection_limit=10&sslmode=require

# ── Tokens ────────────────────────────────────────────────────────────
# Generate each separately with:  openssl rand -hex 64   (they must NOT match)
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_OTHER_64_HEX_BYTES
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# ── Public origin (https only) ────────────────────────────────────────
APP_BASE_URL=https://ind-pm.kpndomain.com
CORS_ORIGIN=https://ind-pm.kpndomain.com

WORKSPACE_TZ=Asia/Jakarta
PORT=3000

# ── Rate limiting and lockout ─────────────────────────────────────────
THROTTLE_LIMIT=5
THROTTLE_GLOBAL=120
THROTTLE_HEAVY=30
LOCKOUT_THRESHOLD=10
LOCKOUT_MINUTES=15

# ── Multi-factor authentication ───────────────────────────────────────
# required | optional | off.  'required' forces every MANAGER and ADMIN to enrol a TOTP
# authenticator before they can use the application.
MFA_POLICY=required
MFA_ISSUER=EngPro

# ── Email ─────────────────────────────────────────────────────────────
SMTP_HOST=mail.energi-up.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply.sys@energi-up.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply.sys@energi-up.com
SMTP_REJECT_UNAUTHORIZED=true
ACTIVATION_TTL_HOURS=72
RESET_TTL_MINUTES=60

# ── DWS Hub single sign-on ────────────────────────────────────────────
# Prefer federated login in production: MFA and joiner/leaver are enforced centrally.
SSO_ENABLED=true
SSO_ISSUER=https://dwshub.kpndomain.com
SSO_CLIENT_ID=ind-pm
SSO_REDIRECT_URI=https://ind-pm.kpndomain.com/api/v1/auth/sso/callback
SSO_SCOPE=openid profile email
SSO_BUTTON_LABEL=Continue with DWS Hub
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ROLE=ESTIMATOR

# ── Audit ─────────────────────────────────────────────────────────────
# Days to retain audit records. The technical documentation commits to 12 months.
AUDIT_RETENTION_DAYS=400
