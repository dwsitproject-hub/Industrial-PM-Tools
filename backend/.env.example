# EngPro API — local development environment (copy to .env)
DATABASE_URL=postgresql://engpro:engpro@localhost:5439/industrial_pm
JWT_ACCESS_SECRET=generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=generate_a_different_one
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
WORKSPACE_TZ=Asia/Jakarta
THROTTLE_LIMIT=5
COOKIE_SECURE=false
PORT=3000

# ── Email (activation + password reset) ───────────────────────────────
# Leave SMTP_HOST empty to run without a mail server: links are written to the API
# log and shown to the manager in the UI to pass on manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EngPro <no-reply@engpro.local>
# Base URL users click back into (the FE origin)
APP_BASE_URL=http://localhost:8090
ACTIVATION_TTL_HOURS=72
RESET_TTL_MINUTES=60

# ── DWS Hub SSO (disabled locally; see .env.staging.example) ──────────
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_REDIRECT_URI=http://localhost:8090/api/v1/auth/sso/callback
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ROLE=ESTIMATOR
